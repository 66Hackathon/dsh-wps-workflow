# TeamSpace API 服务环境变量示例
# 复制为 .env 后按需修改（.env 不入库）

TEAMSPACE_HOST=0.0.0.0
TEAMSPACE_PORT=8090

TEAMSPACE_DB_HOST=127.0.0.1
TEAMSPACE_DB_PORT=3306
TEAMSPACE_DB_USER=teamspace
TEAMSPACE_DB_PASSWORD=teamspace
TEAMSPACE_DB_NAME=teamspace

# docker-compose.yml 使用上述变量启动 MySQL（root 密码 = TEAMSPACE_DB_PASSWORD，库名 = TEAMSPACE_DB_NAME）
# 数据目录 ./data/mysql（已 gitignore）。若 TEAMSPACE_DB_USER=root，应用与容器 root 密码保持一致即可。

# ── WPS OAuth 2.0（授权码模式）────────────────────────────────────────────
# 在 365 开放平台 → 应用 → 安全设置 中配置与 WPS_OAUTH_REDIRECT_URI 一致的回调地址
WPS_OAUTH_CLIENT_ID=
WPS_OAUTH_CLIENT_SECRET=
# 开发时 OAuth 回调指向后端（WPS 授权后重定向到 API 服务）：
WPS_OAUTH_REDIRECT_URI=http://127.0.0.1:8090/api/auth/callback
# OAuth Scope：用户登录授权页勾选的权限（空格分隔）→ 换到的是「用户 access_token」。
#   kso.user_base.read - 登录、获取当前用户
#   kso.file.search    - 云文档搜索（个人盘等，须走用户 Token）
# 改 scope 后必须重新走一遍「使用 WPS 登录」授权，旧 token 不会自动带上新权限。
WPS_OAUTH_SCOPE=kso.user_base.read kso.file.search
WPS_OAUTH_AUTH_URL=https://openapi.wps.cn/oauth2/auth
WPS_OAUTH_TOKEN_URL=https://openapi.wps.cn/oauth2/token
WPS_OAUTH_USER_URL=https://openapi.wps.cn/v7/users/current
# 开发者后台开启「接口签名」时保持 true（默认）
WPS_OAUTH_SIGNATURE_ENABLED=true
# access_token 到期前多少秒自动续期（默认 300 = 5 分钟）
WPS_OAUTH_REFRESH_LEAD_SEC=300

# ── WPS 应用 Token（client_id + secret 直接换，无用户参与）──
# 开发者后台 → 权限申请 →「应用授权」+ 数据权限：
# 通讯录搜索：kso.contact.read
# 创建群聊：  kso.chat.readwrite
# 云文档搜索已改用用户 Token，不再依赖应用侧 kso.file.search。

# ── 登录会话 ────────────────────────────────────────────────────────────────
TEAMSPACE_SESSION_SECRET=change-me-in-production
# OAuth 成功后跳回独立前端；系统 Token 通过 URL ?token= 交给前端存入 localStorage
TEAMSPACE_FRONTEND_REDIRECT_URL=http://127.0.0.1:5173

# 开发模式：开启后提供演示账号选择登录（正式环境务必设为 false 或删除）
TEAMSPACE_DEV_MODE=true
